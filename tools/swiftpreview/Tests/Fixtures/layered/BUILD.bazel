load("@rules_swiftui_previews//previews:defs.bzl", "swiftui_preview_host")

# Layers: Core <- UI <- Profile (the preview). Sibling also imports Core but
# nothing the preview imports depends on it, so it is linked yet not watched.
swiftui_preview_host(
    name = "preview_host",
    platform = "macos",
    deps = [
        "//Features/Profile",
        "//Sibling",
    ],
)
